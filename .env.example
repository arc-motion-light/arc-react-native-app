# ARC Cloud Firebase config for Expo.
# Values come from the Firebase web app config for project arcstore-cloud.
# These are public client identifiers, not MQTT/device credentials.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=arcstore-cloud.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=arcstore-cloud
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=arcstore-cloud.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
